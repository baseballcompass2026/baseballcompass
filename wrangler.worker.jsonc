{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseball-compass-api",
  "main": "workers/index.ts",
  "compatibility_date": "2026-07-29",
  "kv_namespaces": [{ "binding": "BASEBALL_DATA", "id": "edaa716283064b119057ee3fe4ece374" }],
  "d1_databases": [{ "binding": "DB", "database_name": "baseball-compass", "database_id": "125da1ca-66be-4d44-a5f2-50e36e7a4034" }],
  "triggers": { "crons": ["*/30 * * * *", "0 21,3,9 * * *"] },
  "vars": { "APP_TIMEZONE": "Asia/Tokyo", "ALLOWED_ORIGIN": "*", "NEWS_PROVIDER": "gdelt", "NEWS_QUERY": "野球 sourcelang:japanese", "NEWS_FETCH_LIMIT": "75" }
}